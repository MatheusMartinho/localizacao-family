// Copie este arquivo para `Secrets.xcconfig` (que o git ignora) e preencha com
// os dados do seu projeto Supabase — Project Settings → API Keys.
//
// Só o host, sem "https://": no xcconfig, "//" começa um comentário e a barra
// dupla comeria o resto da linha. O app monta a URL.
//
// Sem o Secrets.xcconfig o app roda em modo demonstração, sem backend.

SUPABASE_HOST = SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY = sb_publishable_COLOQUE_A_SUA_CHAVE
